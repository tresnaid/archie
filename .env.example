TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
DATA_DIR=/app/data
TEMP_DIR=/app/tmp
COOKIES_PATH=/app/cookies/cookies.txt
LOG_LEVEL=INFO
# Refuse to download posts whose estimated media size exceeds this many bytes
# (default 2097152000 = 2000 MB, the local Bot API upload cap; 0 disables).
# Posts over this limit can never be uploaded to Telegram, so they fail
# immediately instead of after a long download.
MAX_MEDIA_BYTES=2097152000
# Optional: local Telegram Bot API server for >50 MB uploads (2 GB limit).
# Requires TELEGRAM_API_ID and TELEGRAM_API_HASH from my.telegram.org.
# Leave empty to use the cloud API (50 MB limit).
# LOCAL_BOT_API_HOST=localhost
# LOCAL_BOT_API_PORT=8081
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: embedded monitoring dashboard (localhost only).
# Set to a port number to enable (e.g. 8080). Default: disabled (0).
# DASHBOARD_PORT=8080